# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (read by compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port on localhost where the database is published
POSTGRES_PORT=

# Connection string for the app, must match the values above:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

# Login (Better Auth + Nodemailer)

# Email of the app owner. Contacts and groups that existed before login was added
# are given to this user by the migration. Required when the database already has data.
OWNER_EMAIL=
# Secret that signs login cookies, at least 32 characters. Generate it yourself:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address of the app. Login links in emails are built from it.
# Locally: http://127.0.0.1:3001
BETTER_AUTH_URL=
# Where login emails are sent (SMTP address).
# Locally: smtp://127.0.0.1:1025 (Mailpit, emails are shown at http://127.0.0.1:8025)
SMTP_URL=
# Sender of login emails. Locally any value works, for example: Личная CRM <noreply@example.com>
MAIL_FROM=
